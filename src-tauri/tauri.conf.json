{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "P.N.E. PC Player",
  "version": "0.1.0",
  "identifier": "jp.pne.player",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "security": {
      "csp": "default-src 'self'; script-src 'self' 'wasm-unsafe-eval' http://asset.localhost; connect-src 'self' ipc: http://ipc.localhost http://asset.localhost; img-src 'self' data: blob: http://asset.localhost; media-src 'self' blob: http://asset.localhost; worker-src 'self' blob: http://asset.localhost; style-src 'self'; object-src 'none'; frame-src 'none'; base-uri 'none'; form-action 'none'",
      "assetProtocol": {
        "enable": true,
        "scope": ["$RESOURCE/vendor/irodori-tts-webgpu/**"]
      }
    },
    "windows": [
      {
        "label": "main",
        "title": "P.N.E. PC Player",
        "width": 1280,
        "height": 800,
        "minWidth": 860,
        "minHeight": 620,
        "resizable": true,
        "fullscreen": false,
        "center": true,
        "decorations": true,
        "transparent": false
      }
    ]
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "msi"],
    "resources": {
      "../img/vendor/irodori-tts-webgpu": "vendor/irodori-tts-webgpu"
    },
    "icon": ["icons/icon.png", "icons/icon.ico"],
    "windows": { "webviewInstallMode": { "type": "downloadBootstrapper", "silent": true } }
  },
  "plugins": {
    "deep-link": { "desktop": { "schemes": ["pne"] } }
  }
}
